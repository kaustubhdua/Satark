# Copy to the repository root as .env and protect it (chmod 600 .env).
# This template is not a secret store. Use strong unique values and private backups.
SATARK_DOMAIN=security.example.org
ACME_EMAIL=admin@example.org

# PostgreSQL role password: URL-encode special characters in SATARK_DATABASE_URL.
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
SATARK_DATABASE_URL=postgresql+psycopg://satark:URL_ENCODED_PASSWORD@db:5432/satark
# Separate privileged backup identity; grant BYPASSRLS only for controlled backup/restore.
SATARK_BACKUP_DATABASE_URL=postgresql+psycopg://satark_backup:URL_ENCODED_BACKUP_PASSWORD@db:5432/satark

# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
SATARK_MFA_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
SATARK_REQUIRE_MFA=true
SATARK_REQUIRE_EMAIL_VERIFICATION=true
SATARK_SMTP_HOST=smtp.example.org
SATARK_SMTP_PORT=587
SATARK_SMTP_USERNAME=REPLACE_ME
SATARK_SMTP_PASSWORD=REPLACE_ME
SATARK_SMTP_FROM=SATARK <security@example.org>
SATARK_SMTP_USE_SSL=false

# Independent random secrets: openssl rand -hex 32
FIRSTLIGHT_API_TOKEN=REPLACE_WITH_64_HEX_CHARACTERS
FIRSTLIGHT_WAZUH_SYNC_TOKEN=REPLACE_WITH_64_HEX_CHARACTERS

# Optional Wazuh Indexer (read-only ingestion identity).
FIRSTLIGHT_WAZUH_INDEXER_URL=https://wazuh-indexer.private:9200
FIRSTLIGHT_WAZUH_INDEXER_USERNAME=REPLACE_ME
FIRSTLIGHT_WAZUH_INDEXER_PASSWORD=REPLACE_ME
FIRSTLIGHT_WAZUH_INDEX_PATTERN=wazuh-alerts-*
FIRSTLIGHT_WAZUH_ALLOWED_AGENT_IDS=001
FIRSTLIGHT_WAZUH_TENANT_ID=REPLACE_WITH_TENANT_UUID
FIRSTLIGHT_WAZUH_CASE_ID=REPLACE_WITH_CASE_UUID
FIRSTLIGHT_WAZUH_ACTOR_ID=REPLACE_WITH_USER_UUID
FIRSTLIGHT_WAZUH_INITIAL_SINCE=

# Optional Wazuh Manager API for guarded Active Response.
# Use HTTPS with a CA file mounted under ./secrets; never set HTTP true in production.
FIRSTLIGHT_WAZUH_MANAGER_API_URL=https://wazuh-manager.private:55000
FIRSTLIGHT_WAZUH_MANAGER_USERNAME=REPLACE_WITH_LEAST_PRIVILEGE_API_USER
FIRSTLIGHT_WAZUH_MANAGER_PASSWORD=REPLACE_ME
FIRSTLIGHT_WAZUH_MANAGER_CA_BUNDLE=/run/secrets/wazuh-manager-ca.pem
FIRSTLIGHT_WAZUH_RESPONSE_AGENT_IDS=001
SATARK_ENABLE_LIVE_RESPONSE=false

# Optional local Ollama advisory analysis (disabled unless a private local service is configured).
FIRSTLIGHT_MODEL_AGENTS_ENABLED=false
FIRSTLIGHT_OLLAMA_MODEL=qwen2.5:3b
