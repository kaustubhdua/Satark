# Default: local-only deterministic analysis. No third-party API keys required.
SATARK_ANALYSIS_MODE=local

# Optional: your own Ollama instance. No API key is required.
# For Docker Compose use http://ollama:11434; for local development use http://127.0.0.1:11434.
SATARK_OLLAMA_BASE_URL=http://127.0.0.1:11434
SATARK_OLLAMA_MODEL=qwen2.5:3b

# Legacy third-party provider mode is intentionally not the default.
# Do not enable unless you explicitly want to operate the old external-provider path.
GROQ_API_KEY=
SATARK_ENABLE_THREAT_INTEL=false
URLHAUS_AUTH_KEY=
SATARK_ENABLE_ABUSEIPDB=false
ABUSEIPDB_API_KEY=

# Optional shared rate limiting for explicit legacy provider mode only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Existing persistent case/evidence APIs require a database configuration.
# For self-hosting, use the documented local Supabase/Postgres deployment.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
