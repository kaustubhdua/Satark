# Browser authentication (public/publishable key only; RLS remains the authorization boundary).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side case, evidence, report and analysis API configuration.
# Use the same intended SATARK Supabase project for both sets of values.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Required for the analysis API on Vercel: atomic shared rate limiting (Upstash Redis REST).
# Without both values, /api/analyze fails closed with HTTP 503 in Vercel deployments.
# In local development only, an in-process limiter is used as a convenience fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional self-hosted Ollama model. Deterministic local analysis works without it.
SATARK_OLLAMA_BASE_URL=http://127.0.0.1:11434
SATARK_OLLAMA_MODEL=qwen2.5:3b

# Optional threat intelligence: configure only after approving the data-sharing policy.
SATARK_ENABLE_THREAT_INTEL=false
SATARK_ENABLE_ABUSEIPDB=false
# Keep provider credentials out of this sample file; configure approved secrets only in the deployment secret manager.

# Persistent tenant-isolation integration tests use dedicated NON-PRODUCTION accounts only.
SATARK_TEST_USER_A_EMAIL=
SATARK_TEST_USER_A_PASSWORD=
SATARK_TEST_TENANT_A_ID=
SATARK_TEST_CASE_A_ID=
SATARK_TEST_USER_B_EMAIL=
SATARK_TEST_USER_B_PASSWORD=
SATARK_TEST_TENANT_B_ID=
SATARK_TEST_CASE_B_ID=
SATARK_TEST_EVIDENCE_B_ID=
SATARK_TEST_FINDING_B_ID=
SATARK_TEST_REPORT_B_ID=
SATARK_TEST_STORAGE_OBJECT_B_PATH=
SATARK_TEST_VIEWER_EMAIL=
SATARK_TEST_VIEWER_PASSWORD=
SATARK_TEST_VIEWER_TENANT_ID=