# Optional self-hosted Ollama model. Deterministic local analysis works without it.
SATARK_OLLAMA_BASE_URL=http://127.0.0.1:11434
SATARK_OLLAMA_MODEL=qwen2.5:3b

# Existing persistent case/evidence APIs require a database configuration.
# Set these to your own self-hosted Supabase deployment for durable workflows.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
