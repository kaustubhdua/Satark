# Optional self-hosted Ollama model. Deterministic local analysis works without it.
SATARK_OLLAMA_BASE_URL=http://127.0.0.1:11434
SATARK_OLLAMA_MODEL=qwen2.5:3b

# Optional distributed analysis rate limit (Upstash Redis REST API).
# Configure BOTH values in Vercel Project Settings > Environment Variables to
# enable an atomic cross-instance counter. If only one is present, analysis
# fails closed with HTTP 503 instead of silently downgrading to local-only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Existing persistent case/evidence APIs require a database configuration.
# Set these to your own self-hosted Supabase deployment for durable workflows.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
