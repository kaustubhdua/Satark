NEXT_PUBLIC_API_URL=https://your-backend.example.com

# Server-only secret: set this in your hosting provider's environment settings.
# Never rename this to NEXT_PUBLIC_GROQ_API_KEY.
GROQ_API_KEY=

# Optional URLhaus reputation lookup. Keep disabled until authorized staging validation.
SATARK_ENABLE_THREAT_INTEL=false
URLHAUS_AUTH_KEY=

# Optional AbuseIPDB IP reputation lookup. Keep disabled until authorized staging validation.
SATARK_ENABLE_ABUSEIPDB=false
ABUSEIPDB_API_KEY=

# Optional recommended shared rate limiter for serverless deployments.
# Configure both values in Vercel server-side environment settings to enable it.
# When configured but unreachable, /api/analyze fails closed with HTTP 503.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
