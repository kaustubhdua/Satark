# Browser sign-in configuration. These values are public/publishable, never service-role keys.
# Use the same Supabase project as the server-side SUPABASE_URL below.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side Supabase configuration for persistent cases, evidence, findings, reports and FIRSTLIGHT.
# Use a publishable/anon key; never use a service_role/secret key in the web app.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional self-hosted Ollama model. Deterministic local analysis works without it.
SATARK_OLLAMA_BASE_URL=http://127.0.0.1:11434
SATARK_OLLAMA_MODEL=qwen2.5:3b

# Required for the analysis API on Vercel: atomic shared rate limiting (Upstash Redis REST).
# Without both values, /api/analyze fails closed with HTTP 503 in Vercel deployments.
# In local development only, an in-process limiter is used as a convenience fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional remote FIRSTLIGHT investigation service. Keep the token server-side only.
# Leave both unset to disable the remote service; never prefix the token with NEXT_PUBLIC_.
FIRSTLIGHT_API_URL=
FIRSTLIGHT_API_TOKEN=
