# Optional self-hosted Ollama model. Deterministic local analysis works without it.
SATARK_OLLAMA_BASE_URL=http://127.0.0.1:11434
SATARK_OLLAMA_MODEL=qwen2.5:3b

# Required for the analysis API on Vercel: atomic shared rate limiting (Upstash Redis REST).
# Without both values, /api/analyze fails closed with HTTP 503 in Vercel deployments.
# In local development only, an in-process limiter is used as a convenience fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Persistent case/evidence APIs require a database configuration.
# Set these to your own Supabase deployment for durable workflows.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
