FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg libglib2.0-0 libgl1 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt requirements-local-ai.txt ./
RUN python -m pip install --upgrade pip \
    && pip install -r requirements.txt -r requirements-local-ai.txt

COPY . .
RUN useradd --system --uid 10001 --create-home satark \
    && chown -R satark:satark /app
USER satark
EXPOSE 8501
CMD ["streamlit", "run", "satark.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true"]
