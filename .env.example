# Copy to .env for local Docker Compose development. Never commit real values.
# The default Compose stack is a local demo. Wazuh and durable workers are opt-in profiles.

# SATARK-owned persistence and evidence storage. SQLite is the zero-config local default.
SATARK_DATABASE_URL=sqlite:////data/satark.db
# Optional privileged PostgreSQL URL used only by the backup/restore utility.
# Do not reuse this URL as the runtime API database credential.
SATARK_BACKUP_DATABASE_URL=
SATARK_EVIDENCE_DIR=/data/evidence
SATARK_AUTO_CREATE_SCHEMA=true
SATARK_API_INTERNAL_URL=http://firstlight-api:8788

# Optional TOTP MFA. Generate once with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Keep this stable and private; losing it makes enrolled MFA factors unrecoverable.
SATARK_MFA_ENCRYPTION_KEY=
# Enforce MFA enrollment for every account before accessing workspace data.
SATARK_REQUIRE_MFA=false

# Optional email verification. Enable in production only after SMTP and public URL are configured.
SATARK_REQUIRE_EMAIL_VERIFICATION=false

# Password recovery email (optional; reset requests stay generic when unset).
# Set a public HTTPS URL in production. Use a trusted SMTP provider and secret store.
SATARK_PUBLIC_BASE_URL=http://localhost:3000
# Set the canonical browser origin when TLS terminates before Next.js (e.g. https://satark.example).
SATARK_PUBLIC_ORIGIN=
# Optional Nginx edge profile bind address (set 0.0.0.0 only when intentionally public).
SATARK_EDGE_BIND=127.0.0.1
SATARK_SMTP_HOST=
SATARK_SMTP_PORT=587
SATARK_SMTP_USERNAME=
SATARK_SMTP_PASSWORD=
SATARK_SMTP_FROM=
SATARK_SMTP_USE_SSL=false

# Local FIRSTLIGHT API shared-secret tokens: generate independent values with:
# openssl rand -hex 32
FIRSTLIGHT_API_TOKEN=
FIRSTLIGHT_WAZUH_SYNC_TOKEN=

# Guarded Wazuh Active Response. Disabled unless explicitly enabled in the trusted API.
# Only allowlisted disposable lab agents can receive fixed built-in commands.
SATARK_ENABLE_LIVE_RESPONSE=false
FIRSTLIGHT_WAZUH_MANAGER_API_URL=
FIRSTLIGHT_WAZUH_MANAGER_USERNAME=
FIRSTLIGHT_WAZUH_MANAGER_PASSWORD=
FIRSTLIGHT_WAZUH_MANAGER_CA_BUNDLE=
FIRSTLIGHT_WAZUH_MANAGER_ALLOW_HTTP=false
FIRSTLIGHT_WAZUH_RESPONSE_AGENT_IDS=

# Wazuh connector (private lab only; use HTTPS and a read-only Indexer identity).
# Start the optional ingestion worker with: docker compose --profile wazuh up
FIRSTLIGHT_WAZUH_TENANT_ID=
FIRSTLIGHT_WAZUH_CASE_ID=
FIRSTLIGHT_WAZUH_ACTOR_ID=
FIRSTLIGHT_WAZUH_INITIAL_SINCE=
FIRSTLIGHT_WAZUH_INDEXER_URL=
FIRSTLIGHT_WAZUH_INDEXER_USERNAME=
FIRSTLIGHT_WAZUH_INDEXER_PASSWORD=
FIRSTLIGHT_WAZUH_INDEX_PATTERN=wazuh-alerts-*
FIRSTLIGHT_WAZUH_ALLOWED_AGENT_IDS=
FIRSTLIGHT_WAZUH_ALLOW_HTTP=false
FIRSTLIGHT_WAZUH_PAGE_SIZE=100
FIRSTLIGHT_WAZUH_OVERLAP_SECONDS=300
FIRSTLIGHT_WAZUH_POLL_SECONDS=60

# Optional local model settings
SATARK_OLLAMA_MODEL=qwen2.5:3b
FIRSTLIGHT_OLLAMA_MODEL=qwen2.5:3b
FIRSTLIGHT_MODEL_AGENTS_ENABLED=false
FIRSTLIGHT_JOB_POLL_SECONDS=5
FIRSTLIGHT_JOB_LEASE_SECONDS=120

