# Copy to .env for local Docker Compose development. Never commit real values.
# The default Compose stack is a local demo. Wazuh and durable workers are opt-in profiles.

# SATARK-owned persistence and evidence storage. SQLite is the zero-config local default.
SATARK_DATABASE_URL=sqlite:////data/satark.db
SATARK_EVIDENCE_DIR=/data/evidence
SATARK_AUTO_CREATE_SCHEMA=true
SATARK_API_INTERNAL_URL=http://firstlight-api:8788

# Local FIRSTLIGHT API shared-secret tokens: generate independent values with:
# openssl rand -hex 32
FIRSTLIGHT_API_TOKEN=
FIRSTLIGHT_WAZUH_SYNC_TOKEN=

# Wazuh connector (private lab only; use HTTPS and a read-only Indexer identity)
FIRSTLIGHT_WAZUH_TENANT_ID=
FIRSTLIGHT_WAZUH_CASE_ID=
FIRSTLIGHT_WAZUH_ACTOR_ID=
FIRSTLIGHT_WAZUH_INITIAL_SINCE=
FIRSTLIGHT_WAZUH_INDEXER_URL=
FIRSTLIGHT_WAZUH_INDEXER_USERNAME=
FIRSTLIGHT_WAZUH_INDEXER_PASSWORD=
FIRSTLIGHT_WAZUH_INDEX_PATTERN=wazuh-alerts-*
FIRSTLIGHT_WAZUH_ALLOWED_AGENT_IDS=
FIRSTLIGHT_WAZUH_ALLOW_HTTP=false
FIRSTLIGHT_WAZUH_PAGE_SIZE=100
FIRSTLIGHT_WAZUH_OVERLAP_SECONDS=300
FIRSTLIGHT_WAZUH_POLL_SECONDS=60

# Optional local model settings
SATARK_OLLAMA_MODEL=qwen2.5:3b
FIRSTLIGHT_OLLAMA_MODEL=qwen2.5:3b
FIRSTLIGHT_MODEL_AGENTS_ENABLED=false
FIRSTLIGHT_JOB_POLL_SECONDS=5
FIRSTLIGHT_JOB_LEASE_SECONDS=120
