FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app

COPY firstlight-api-requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY firstlight_engine.py ./firstlight_engine.py
COPY firstlight_rules.py ./firstlight_rules.py
COPY firstlight_agents.py ./firstlight_agents.py
COPY firstlight_wazuh.py ./firstlight_wazuh.py
COPY firstlight_response_executor.py ./firstlight_response_executor.py
COPY firstlight_response_api.py ./firstlight_response_api.py
COPY integrations ./integrations
COPY ai_provider.py ./ai_provider.py
COPY firstlight_api.py ./firstlight_api.py
COPY satark_backend.py ./satark_backend.py
COPY alembic.ini ./alembic.ini
COPY migrations ./migrations
COPY scripts/satark_backup.py ./scripts/satark_backup.py
RUN mkdir -p /data/evidence && chown -R 10001:10001 /data
USER 10001:10001
EXPOSE 8788
CMD ["sh", "-c", "alembic upgrade head && exec uvicorn firstlight_api:app --host 0.0.0.0 --port 8788 --proxy-headers --forwarded-allow-ips=\"${SATARK_TRUSTED_PROXY_IPS:-*}\""]
