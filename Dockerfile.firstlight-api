FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app

COPY firstlight-api-requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY firstlight_engine.py ./firstlight_engine.py
COPY firstlight_rules.py ./firstlight_rules.py
COPY firstlight_agents.py ./firstlight_agents.py
COPY firstlight_wazuh.py ./firstlight_wazuh.py
COPY ai_provider.py ./ai_provider.py
COPY firstlight_api.py ./firstlight_api.py
USER 10001:10001
EXPOSE 8788
CMD ["uvicorn", "firstlight_api:app", "--host", "0.0.0.0", "--port", "8788"]
