FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app

COPY firstlight-api-requirements.txt ./requirements.txt
COPY requirements-s3.txt ./requirements-s3.txt
RUN pip install --no-cache-dir -r requirements.txt -r requirements-s3.txt
COPY firstlight_engine.py ./firstlight_engine.py
COPY firstlight_rules.py ./firstlight_rules.py
COPY firstlight_wazuh.py ./firstlight_wazuh.py
COPY firstlight_wazuh_worker.py ./firstlight_wazuh_worker.py
COPY satark_backend.py ./satark_backend.py
COPY evidence_store.py ./evidence_store.py
USER 10001:10001
CMD ["python", "firstlight_wazuh_worker.py"]
